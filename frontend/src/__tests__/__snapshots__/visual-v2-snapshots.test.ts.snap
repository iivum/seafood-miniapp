"<button
  class="btn-shared btn-shared--{{type}} {{disabled ? 'is-disabled' : ''}} {{loading ? 'is-loading' : ''}}"
  bindtap="onTap"
  disabled="{{disabled || loading}}"
>
  <text wx:if="{{loading}}" class="btn-shared__spinner"></text>
  <slot />
</button>"
`;

exports[`OD v2 视觉契约(7 个组件) shared/components/Button WXSS 视觉快照: wxss:shared/components/Button 1`] = `
"/*
 * OD v2 visual — accent 实色 + pill + 蓝调阴影
 * tokens 来源:frontend/src/shared/tokens/tokens.wxss(由 docs/redesign/tokens.json 派生)
 * 替换 v1 的 --color-primary/--radius-lg,沿用 OD posture 1 / 2
 *   - primary-action-solid:实色 accent(非 135° 渐变)
 *   - shadow-blue-neutral:蓝调阴影(非红调)
 *   - radius-pill:pill 圆角,无边框态
 */

.btn-shared {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: var(--radius-pill, 9999px);
  padding: 20rpx 36rpx;
  font-size: 30rpx;
  line-height: 1.4;
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  margin: 0;
  font-family: var(--font-body, -apple-system, BlinkMacSystemFont, sans-serif);
  font-weight: 600;
  letter-spacing: 0.2rpx;
  box-shadow: var(--shadow-md);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.btn-shared:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-sm);
}

.btn-shared--secondary {
  background: var(--surface, #fff);
  color: var(--fg, #231814);
  box-shadow: inset 0 0 0 2rpx var(--border-strong, #d5cbc8);
}

.btn-shared--secondary:active {
  background: var(--bg, #fffbf8);
}

.btn-shared--ghost {
  background: transparent;
  color: var(--accent-strong, #b83300);
  box-shadow: none;
  padding: 20rpx 28rpx;
}

.btn-shared--ghost:active {
  background: var(--accent-soft, #ffe7d9);
}

.btn-shared.is-disabled {
  opacity: 0.4;
  box-shadow: none;
}

.btn-shared__spinner {
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #ffffff;
  border-top-color: var(--surface, #fff);
  border-radius: 50%;
  margin-right: 8rpx;
  animation: btn-shared-spin 0.8s linear infinite;
}

.btn-shared--secondary .btn-shared__spinner,
.btn-shared--ghost .btn-shared__spinner {
  border-color: var(--border-strong, #d5cbc8);
  border-top-color: var(--accent, #db633c);
}

@keyframes btn-shared-spin {
  to { transform: rotate(360deg); }
}

.btn-shared::after {
  border: none;
}"
`;

exports[`OD v2 视觉契约(7 个组件) shared/components/Empty WXML 结构快照: wxml:shared/components/Empty 1`] = `
