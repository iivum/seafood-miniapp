"<view class="cart-item-row">
  <view wx:if="{{!readonly}}" class="cart-item-row__check" catchtap="onToggle">
    <view class="checkbox {{item.selected ? 'checkbox--on' : ''}}"></view>
  </view>
  <image class="cart-item-row__image" src="{{item.imageUrl}}" mode="aspectFill" />
  <view class="cart-item-row__body">
    <view class="cart-item-row__name">{{item.name || item.productId}}</view>
    <view class="cart-item-row__price">¥ {{item.price}}</view>
    <view class="cart-item-row__qty">
      <view wx:if="{{!readonly}}" class="cart-item-row__btn" catchtap="onMinus">-</view>
      <text class="cart-item-row__count">{{item.quantity}}</text>
      <view wx:if="{{!readonly}}" class="cart-item-row__btn" catchtap="onPlus">+</view>
    </view>
  </view>
  <view wx:if="{{!readonly}}" class="cart-item-row__remove" catchtap="onRemove">删除</view>
</view>"
`;

exports[`OD v2 视觉契约(7 个组件) features/cart/components/CartItemRow WXSS 视觉快照: wxss:features/cart/components/CartItemRow 1`] = `
"/*
 * OD v2 visual — surface 列表行 + accent checkbox-on + 衬线价格
 * posture 3 价格用 accent;6 state-only 用 state 颜色
 */

.cart-item-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--surface, #fff);
  border-bottom: 1rpx solid var(--border, #e6e0dd);
  transition: background 0.18s ease;
}

.cart-item-row__check {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--border-strong, #d5cbc8);
  border-radius: 50%;
  background: var(--surface, #fff);
  transition: all 0.18s ease;
}

.checkbox--on {
  background: var(--accent, #db633c);
  border-color: var(--accent, #db633c);
  box-shadow: 0 2rpx 8rpx #231814;
}

.cart-item-row__image {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-lg, 10px);
  background: var(--bg, #fffbf8);
  margin-right: 16rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.cart-item-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 140rpx;
  padding: 4rpx 0;
}

.cart-item-row__name {
  font-family: var(--font-body, -apple-system, sans-serif);
  font-size: 28rpx;
  color: var(--fg, #231814);
  font-weight: 500;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.cart-item-row__price {
  color: var(--accent, #db633c);
  font-family: var(--font-display, "Source Serif Pro", Georgia, serif);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
}

.cart-item-row__price::before {
  content: '¥';
  font-size: 22rpx;
  margin-right: 2rpx;
  font-weight: 500;
}

.cart-item-row__qty {
  display: flex;
  align-items: center;
  align-self: flex-end;
  margin-top: 8rpx;
}

.cart-item-row__btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg, #fffbf8);
  border-radius: var(--radius-md, 6px);
  font-size: 32rpx;
  color: var(--fg, #231814);
  font-weight: 500;
  border: 1rpx solid var(--border, #e6e0dd);
  transition: background 0.18s ease, transform 0.18s ease;
}

.cart-item-row__btn:active {
  background: var(--accent-soft, #ffe7d9);
  transform: scale(0.92);
}

.cart-item-row__count {
  width: 72rpx;
  text-align: center;
  font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
  font-size: 28rpx;
  color: var(--fg, #231814);
}

.cart-item-row__remove {
  color: var(--muted, #6b615d);
  font-family: var(--font-body, -apple-system, sans-serif);
  font-size: 24rpx;
  margin-left: 16rpx;
  align-self: flex-start;
  padding: 8rpx 0;
}"
`;

exports[`OD v2 视觉契约(7 个组件) features/order/components/OrderItemRow WXML 结构快照: wxml:features/order/components/OrderItemRow 1`] = `
"<view class="order-item-row" bindtap="onTap">
  <view class="order-item-row__head">
    <text class="order-item-row__id">订单号: {{order.id}}</text>
    <text class="order-item-row__status status--{{order.status}}">{{order.status}}</text>
  </view>
  <view class="order-item-row__body">
    <block wx:for="{{order.items}}" wx:key="productId" wx:for-item="line">
      <view class="order-item-row__line">
        <text class="order-item-row__name">{{line.productName}}</text>
        <text class="order-item-row__qty">x {{line.quantity}}</text>
        <text class="order-item-row__price">¥ {{line.unitPrice}}</text>
      </view>
    </block>
  </view>
  <view class="order-item-row__foot">
    <text class="order-item-row__total">合计: ¥ {{order.totalAmount}}</text>
    <button
      wx:if="{{order.status === 'PENDING'}}"
      class="order-item-row__cancel"
      size="mini"
      catchtap="onCancel"
    >取消订单</button>
  </view>
</view>"
`;

exports[`OD v2 视觉契约(7 个组件) features/order/components/OrderItemRow WXSS 视觉快照: wxss:features/order/components/OrderItemRow 1`] = `
"/*
 * OD v2 visual — surface 卡片 + shadow-sm + state 色标
 * posture 6 state-only-not-brand:状态色只用于状态标签,不入品牌叙事
 */

.order-item-row {
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  margin: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx #231814;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.order-item-row:active {
  transform: scale(0.99);
  box-shadow: 0 1rpx 4rpx #231814;
}

.order-item-row__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border, #e6e0dd);
}

.order-item-row__id {
  font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
  font-size: 24rpx;
  color: var(--muted, #6b615d);
  letter-spacing: 0.2rpx;
}

.order-item-row__status {
  font-family: var(--font-body, -apple-system, sans-serif);
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill, 9999px);
  letter-spacing: 0.4rpx;
}

/* 状态色标:soft 背景 + 强色文字,符合 OD posture 6(state-only) */
.status--PENDING   { color: var(--warning, #df911a);  background: var(--warning-soft, #ffe9cb); }
.status--PAID      { color: var(--info, #1988a3);    background: var(--info-soft, #d2f5ff); }
.status--SHIPPED   { color: var(--accent-strong, #b83300); background: var(--accent-soft, #ffe7d9); }
.status--COMPLETED { color: var(--success, #318f5a); background: var(--success-soft, #d5f9e0); }
.status--CANCELLED { color: var(--soft, #a59c99);    background: var(--bg, #fffbf8); }
.status--REFUNDING { color: var(--error, #b9003d);    background: var(--error-soft, #ffe2e4); }
.status--REFUNDED  { color: var(--accent-deep, #64230d); background: var(--bg, #fffbf8); }

.order-item-row__body {
  padding: 12rpx 0;
}

.order-item-row__line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--fg, #231814);
  font-family: var(--font-body, -apple-system, sans-serif);
}

.order-item-row__name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
  color: var(--fg, #231814);
}

.order-item-row__qty {
  color: var(--soft, #a59c99);
  font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
  margin: 0 16rpx;
}

.order-item-row__price {
  font-family: var(--font-display, "Source Serif Pro", Georgia, serif);
  color: var(--fg, #231814);
  font-weight: 500;
}

.order-item-row__foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border, #e6e0dd);
  margin-top: 12rpx;
}

.order-item-row__total {
  font-family: var(--font-display, "Source Serif Pro", Georgia, serif);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--accent, #db633c);
  letter-spacing: 0.4rpx;
}

.order-item-row__total::before {
  content: '合计 ¥';
  font-family: var(--font-body, -apple-system, sans-serif);
  font-size: 24rpx;
  color: var(--muted, #6b615d);
  font-weight: 400;
  margin-right: 4rpx;
}

.order-item-row__cancel {
  background: transparent;
  color: var(--muted, #6b615d);
  border: 1rpx solid var(--border-strong, #d5cbc8);
  border-radius: var(--radius-pill, 9999px);
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  line-height: 1.4;
  font-family: var(--font-body, -apple-system, sans-serif);
  font-weight: 500;
}

.order-item-row__cancel::after {
  border: none;
}"
`;

