exports[`OD v2 视觉契约(7 个组件) shared/components/Loading WXSS 视觉快照: wxss:shared/components/Loading 1`] = `
"/*
 * OD v2 visual — accent 双环 spinner + 衬线小字
 * posture 4:衬线 message 区分系统/应用文案
 */

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 0;
  color: var(--muted, #6b615d);
}

.loading__spinner {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 20rpx;
}

.loading__spinner::before,
.loading__spinner::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.loading__spinner::before {
  border-top-color: var(--accent, #db633c);
  border-right-color: var(--accent-soft, #ffe7d9);
  animation: loading-spin 0.9s cubic-bezier(0.5, 0.1, 0.5, 0.9) infinite;
}

.loading__spinner::after {
  border-bottom-color: var(--accent-soft, #ffe7d9);
  border-left-color: var(--accent-strong, #b83300);
  animation: loading-spin 1.4s cubic-bezier(0.5, 0.1, 0.5, 0.9) infinite reverse;
  opacity: 0.55;
}

.loading__message {
  font-family: var(--font-display, "Source Serif Pro", Georgia, serif);
  font-size: 26rpx;
  color: var(--muted, #6b615d);
  letter-spacing: 0.4rpx;
}

@keyframes loading-spin {
  to { transform: rotate(360deg); }
}"
`;
