.btn-shared {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: var(--radius-lg, 8px);
  padding: 20rpx 32rpx;
  font-size: 30rpx;
  line-height: 1.4;
  background: var(--color-primary, #FF6B6B);
  color: #fff;
  margin: 0;
}

.btn-shared--secondary {
  background: var(--color-secondary, #4ECDC4);
}

.btn-shared--ghost {
  background: transparent;
  color: var(--color-primary, #FF6B6B);
  border: 2rpx solid var(--color-primary, #FF6B6B);
}

.btn-shared.is-disabled {
  opacity: 0.4;
}

.btn-shared__spinner {
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  border-top-color: #fff;
  border-radius: 50%;
  margin-right: 8rpx;
  animation: btn-shared-spin 0.8s linear infinite;
}

@keyframes btn-shared-spin {
  to { transform: rotate(360deg); }
}

.btn-shared::after {
  border: none;
}
