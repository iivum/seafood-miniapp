.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-32, 32px) 0;
  color: var(--color-text-secondary, #6b7280);
}

.loading__spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--color-border, #e5e7eb);
  border-top-color: var(--color-primary, #FF6B6B);
  border-radius: 50%;
  animation: loading-spin 0.8s linear infinite;
  margin-bottom: var(--space-12, 12px);
}

.loading__message {
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b7280);
}

@keyframes loading-spin {
  to { transform: rotate(360deg); }
}
