/*
 * OD v2 visual — 衬线 display + accent-soft 描边图标
 * posture 4:serif-fresh-not-trendy(Fraunces 数字 + 英文 + 常用汉字子集)
 */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
  color: var(--muted, #6b615d);
  text-align: center;
  background: transparent;
}

.empty__icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  background: var(--accent-soft, #ffe7d9);
  color: var(--accent-strong, #b83300);
  border-radius: var(--radius-pill, 9999px);
  font-family: var(--font-display, "Source Serif Pro", Georgia, serif);
}

.empty__message {
  font-family: var(--font-display, "Source Serif Pro", Georgia, serif);
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 400;
  letter-spacing: 0.4rpx;
  color: var(--fg, #231814);
  margin-bottom: 32rpx;
}

.empty__retry {
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  border-radius: var(--radius-pill, 9999px);
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  border: none;
  line-height: 1.4;
  font-family: var(--font-body, -apple-system, sans-serif);
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx #231814;
}

.empty__retry::after {
  border: none;
}
