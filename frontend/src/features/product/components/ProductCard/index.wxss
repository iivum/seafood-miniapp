/*
 * OD v2 visual — surface 卡片 + shadow-sm 蓝调阴影 + accent 价格
 * posture 1 实色 accent(价格)/ 2 蓝调阴影 / 3 价格用 ink or accent
 */

.product-card {
  display: flex;
  align-items: stretch;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  padding: 20rpx;
  margin: 16rpx;
  box-shadow: 0 2rpx 10rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.product-card:active {
  transform: scale(0.99);
  box-shadow: 0 1rpx 4rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.product-card__image {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-lg, 10px);
  background: var(--bg, #fffbf8);
  flex-shrink: 0;
  object-fit: cover;
}

.product-card__body {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  justify-content: space-between;
}

.product-card__name {
  font-family: var(--font-body, -apple-system, sans-serif);
  font-size: 30rpx;
  color: var(--fg, #231814);
  font-weight: 500;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
}

.product-card__price {
  color: var(--accent, #db633c);
  font-family: var(--font-display, "Source Serif Pro", Georgia, serif);
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 8rpx;
  letter-spacing: 0.4rpx;
}

.product-card__price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
  font-weight: 500;
}

.product-card__stock {
  color: var(--soft, #a59c99);
  font-family: var(--font-body, -apple-system, sans-serif);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.product-card__add {
  align-self: flex-end;
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  font-size: 24rpx;
  border-radius: var(--radius-pill, 9999px);
  padding: 10rpx 24rpx;
  margin-top: 12rpx;
  line-height: 1.3;
  font-family: var(--font-body, -apple-system, sans-serif);
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.product-card__add::after {
  border: none;
}
