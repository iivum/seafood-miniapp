<view class="product-list">
  <shared-loading visible="{{loading}}" message="加载中..." />
  <shared-empty
    wx:if="{{!loading && !error && products.length === 0}}"
    message="暂无商品"
  />
  <shared-empty
    wx:if="{{error}}"
    message="{{error}}"
    retryable="{{true}}"
    bind:retry="onRetry"
  />
  <block wx:for="{{products}}" wx:key="id">
    <product-card
      product="{{item}}"
      bind:tap="onProductTap"
      bind:add="onAddToCart"
    />
  </block>
</view>
