<view class="order-item-row" bindtap="onTap">
  <view class="order-item-row__head">
    <text class="order-item-row__id">订单号: {{order.id}}</text>
    <text class="order-item-row__status status--{{order.status}}">{{order.status}}</text>
  </view>
  <view class="order-item-row__body">
    <block wx:for="{{order.items}}" wx:key="productId" wx:for-item="line">
      <view class="order-item-row__line">
        <text class="order-item-row__name">{{line.productName}}</text>
        <text class="order-item-row__qty">x {{line.quantity}}</text>
        <text class="order-item-row__price">¥ {{line.unitPrice}}</text>
      </view>
    </block>
  </view>
  <view class="order-item-row__foot">
    <text class="order-item-row__total">合计: ¥ {{order.totalAmount}}</text>
    <button
      wx:if="{{order.status === 'PENDING'}}"
      class="order-item-row__cancel"
      size="mini"
      catchtap="onCancel"
    >取消订单</button>
  </view>
</view>
