/*
 * OrderActionRow — mp-08 OD 对齐时补建的渲染层样式。
 * 4 个 variant 配色沿用项目内已有按钮惯例(不新增 token,不裸写 hex)：
 *   primary   — 实心 accent-strong + surface 文字,同 mp-03 product-detail
 *               "立即购买"按钮(WCAG AA 已修:accent-strong 对 surface 的
 *               对比度 5.98,达 4.5+ 标准)。
 *   secondary — outline(surface 底 + border-strong 描边 + fg 文字),同
 *               OrderItemRow `__cancel` 按钮惯例(同一订单组件族)。
 *   danger    — error 色系(error-soft 底 + error 文字),同 cart
 *               `.cart-item__remove--hover` 的 error 配色家族。
 *   disabled  — muted 底 + surface 文字 + 降低透明度,同 order-confirm
 *               `.bottom-bar__submit.is-disabled` 惯例。
 * tokens 全部走 var(--token, fallback) — 单一源 docs/redesign/tokens.json。
 */

.order-action-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 16rpx;
}

.order-action-row__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  border-radius: var(--radius-pill, 9999px);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.6;
  transition: opacity 0.18s ease;
}

.order-action-row__btn--hover {
  opacity: 0.7;
}

.order-action-row__btn--primary {
  background: var(--accent-strong, #b83300);
  color: var(--surface, #fff);
}

.order-action-row__btn--secondary {
  background: var(--surface, #fff);
  color: var(--fg, #231814);
  box-shadow: inset 0 0 0 1rpx var(--border-strong, #d5cbc8);
}

.order-action-row__btn--danger {
  background: var(--error-soft, #ffe2e4);
  color: var(--error, #b9003d);
}

.order-action-row__btn--disabled {
  background: var(--muted, #6b615d);
  color: var(--surface, #fff);
  opacity: 0.5;
}
