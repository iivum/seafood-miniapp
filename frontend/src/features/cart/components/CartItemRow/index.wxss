/*
 * OD v2 visual — surface 列表行 + accent checkbox-on + 衬线价格
 * posture 3 价格用 accent;6 state-only 用 state 颜色
 */

.cart-item-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--surface, #fff);
  border-bottom: 1rpx solid var(--border, #e6e0dd);
  transition: background 0.18s ease;
}

.cart-item-row__check {
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--border-strong, #d5cbc8);
  border-radius: 50%;
  background: var(--surface, #fff);
  transition: all 0.18s ease;
}

.checkbox--on {
  background: var(--accent, #db633c);
  border-color: var(--accent, #db633c);
  box-shadow: 0 2rpx 8rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.cart-item-row__image {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-lg, 10px);
  background: var(--bg, #fffbf8);
  margin-right: 16rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.cart-item-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 140rpx;
  padding: 4rpx 0;
}

.cart-item-row__name {
  font-family: var(--font-body, -apple-system, sans-serif);
  font-size: 28rpx;
  color: var(--fg, #231814);
  font-weight: 500;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.cart-item-row__price {
  color: var(--accent, #db633c);
  font-family: var(--font-display, "Source Serif Pro", Georgia, serif);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
}

.cart-item-row__price::before {
  content: '¥';
  font-size: 22rpx;
  margin-right: 2rpx;
  font-weight: 500;
}

.cart-item-row__qty {
  display: flex;
  align-items: center;
  align-self: flex-end;
  margin-top: 8rpx;
}

.cart-item-row__btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg, #fffbf8);
  border-radius: var(--radius-md, 6px);
  font-size: 32rpx;
  color: var(--fg, #231814);
  font-weight: 500;
  border: 1rpx solid var(--border, #e6e0dd);
  transition: background 0.18s ease, transform 0.18s ease;
}

.cart-item-row__btn:active {
  background: var(--accent-soft, #ffe7d9);
  transform: scale(0.92);
}

.cart-item-row__count {
  width: 72rpx;
  text-align: center;
  font-family: var(--font-mono, "IBM Plex Mono", ui-monospace, monospace);
  font-size: 28rpx;
  color: var(--fg, #231814);
}

.cart-item-row__remove {
  color: var(--muted, #6b615d);
  font-family: var(--font-body, -apple-system, sans-serif);
  font-size: 24rpx;
  margin-left: 16rpx;
  align-self: flex-start;
  padding: 8rpx 0;
}
