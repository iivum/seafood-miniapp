/**
 * app.wxss — v1 + v2 tokens co-exist.
 *
 * v2 tokens (inlined at bottom) win the CSS cascade over v1 blocks.
 * Components use v2 variable names: var(--accent), var(--fg), etc.
 * The v1 blocks are kept as fallback for any remaining var(--color-*) refs.
 *
 * To fully remove v1:
 *   1. delete the === TOKENS:BEGIN === block
 *   2. remove any remaining var(--color-*) refs
 *   3. remove this header note
 */
@import '/src/shared/tokens/fonts.wxss';

/**app.wxss - Ocean Market Premium **/

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

page {
  /* Vibrant Modern Palette */
  --color-primary: #FF6B6B;
  --color-secondary: #4ECDC4;
  --color-accent: #FFE66D;
  --color-dark: #1A1A2E;
  --color-surface: #ffffff;
  --color-bg: #F7F8FC;
  --color-bg-subtle: #F0F1F5;
  --color-text: #2D3436;
  --color-text-secondary: #95A5A6;
  --color-text-muted: #B4B8BC;
  --color-border: #E8EAED;
  --color-divider: #F0F1F5;
  --color-price: #FF6B6B;

  /* Safe Area Variables */
  --safe-area-top: env(safe-area-inset-top);
  --safe-area-bottom: env(safe-area-inset-bottom);
  --safe-area-left: env(safe-area-inset-left);
  --safe-area-right: env(safe-area-inset-right);

  /* Fixed Bar Heights */
  --fixed-bar-height: 100rpx;
  --fixed-bar-height-lg: 120rpx;

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  color: var(--color-text);
}

.primary-color {
  color: var(--color-primary);
}

.bg-primary {
  background-color: var(--color-primary);
}

.accent-color {
  color: var(--color-accent);
}

.bg-accent {
  background-color: var(--color-accent);
}

.success-color {
  color: var(--color-success);
}

.price-color {
  color: var(--color-price);
}

.btn {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  text-align: center;
}

.btn-accent {
  background: linear-gradient(135deg, #4ECDC4 0%, #6FE3DB 100%);
  color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  text-align: center;
}

.card {
  background-color: var(--color-surface);
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.12);
  border: 1rpx solid var(--color-border);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* ============================================
   Safe Area Utilities
   ============================================ */
.safe-area-top {
  padding-top: var(--safe-area-top);
}

.safe-area-bottom {
  padding-bottom: var(--safe-area-bottom);
}

.safe-area-bottom-fixed {
  padding-bottom: calc(var(--fixed-bar-height) + var(--safe-area-bottom));
}

.safe-area-bottom-content {
  padding-bottom: calc(var(--fixed-bar-height) + var(--safe-area-bottom) + 20rpx);
}

.safe-area-left {
  padding-left: var(--safe-area-left);
}

.safe-area-right {
  padding-right: var(--safe-area-right);
}

/* === TOKENS:BEGIN === */
page {
  --color-accent: #FF7C7C;
  --color-bg: #F7F8FC;
  --color-bg-subtle: #F0F0F4;
  --color-border: #E5E7EB;
  --color-dark: #1A1A2E;
  --color-divider: #F0F0F4;
  --color-error: #EF4444;
  --color-info: #3B82F6;
  --color-price: #E85555;
  --color-primary: #E85555;
  --color-primary-soft: #FFCECE;
  --color-secondary: #4ECDC4;
  --color-success: #10B981;
  --color-surface: #FFFFFF;
  --color-text: #1A1A2E;
  --color-text-muted: #6B7280;
  --color-text-secondary: #6B7280;
  --color-warning: #F59E0B;
  --font-size-body: 14px;
  --font-size-display: 36px;
  --font-size-h1: 28px;
  --font-size-h2: 20px;
  --font-size-h3: 16px;
  --font-size-small: 12px;
  --font-size-xs: 10px;
  --radius-2xl: 16px;
  --radius-full: 9999px;
  --radius-lg: 8px;
  --radius-md: 6px;
  --radius-sm: 4px;
  --radius-xl: 12px;
  --space-12: 12px;
  --space-16: 16px;
  --space-20: 20px;
  --space-24: 24px;
  --space-32: 32px;
  --space-4: 4px;
  --space-8: 8px;
  --z-dropdown: 300;
  --z-modal: 400;
  --z-toast: 500;
}
/* === TOKENS:END   === */

/* v2 tokens — inlined AFTER v1 block so these win the cascade.
   Components use var(--accent), var(--fg), var(--surface) etc.
   Auto-generated from docs/redesign/tokens.json by scripts/build-tokens.js */
page {
  --bg: #fffbf8;
  --surface: #ffffff;
  --fg: #231814;
  --muted: #6b615d;
  --soft: #a59c99;
  --border: #e6e0dd;
  --border-strong: #d5cbc8;
  --accent: #db633c;
  --accent-soft: #ffe7d9;
  --accent-strong: #b83300;
  --accent-deep: #64230d;
  --success: #318f5a;
  --warning: #df911a;
  --error: #b9003d;
  --info: #1988a3;
  --success-soft: #d5f9e0;
  --warning-soft: #ffe9cb;
  --error-soft: #ffe2e4;
  --info-soft: #d2f5ff;
  --radius-sm: 4px;
  --radius-md: 6px;
  --radius-lg: 10px;
  --radius-xl: 14px;
  --radius-2xl: 16px;
  --radius-3xl: 18px;
  --radius-pill: 9999px;
  --shadow-sm: rgba(35, 24, 20, 0.05);
  --shadow-md: rgba(35, 24, 20, 0.07);
  --shadow-lg: rgba(35, 24, 20, 0.1);
  --font-display: "Fraunces, 'Source Serif Pro', 'Iowan Old Style', Georgia, serif";
  --font-body: "Inter Tight, -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif";
  --font-mono: "Geist Mono, 'IBM Plex Mono', ui-monospace, Menlo, monospace";
}

/* === 路线图 3.16 死交互修复(S-2)=== */
/* 全局 .is-clicked 闪:0.18s 缩放 + 透明度,各屏 wxml hover 元素加
   hover-class="is-clicked" hover-stay-time="100" 即可生效。
   覆盖 [data-action] / [data-toggle] / chips / tab / 全选 / stepper / 结算 等。*/
.is-clicked {
  opacity: 0.6;
  transform: scale(0.97);
  transition: opacity 0.18s ease, transform 0.18s ease;
}
