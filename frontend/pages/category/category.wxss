/*
 * 路线图 2.2 — mp-02 分类列表 OD v2 视觉。
 * 双栏:左 sidebar + 右 grid(同 2.1 网格样式)。
 * tokens 单一源 docs/redesign/tokens.json。
 */

.cat-container {
  display: flex;
  min-height: 100vh;
  background: var(--bg, #fffbf8);
}

/* ===== 左侧 sidebar ===== */

.cat-sidebar {
  width: 200rpx;
  flex-shrink: 0;
  background: var(--surface, #fff);
  border-right: 1rpx solid var(--border, #eae3e1);
}

.cat-sidebar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 28rpx 12rpx;
  font-size: 26rpx;
  color: var(--muted, #5a5451);
  position: relative;
  transition: background 0.18s ease, color 0.18s ease;
}

.cat-sidebar__item--active {
  background: var(--bg, #fffbf8);
  color: var(--accent-strong, #b83300);
  font-weight: 600;
}

.cat-sidebar__item--active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  background: var(--accent, #db633c);
  border-radius: 0 6rpx 6rpx 0;
}

.cat-sidebar__emoji {
  font-size: 40rpx;
}

.cat-sidebar__name {
  font-size: 24rpx;
  text-align: center;
}

/* ===== 右侧主区 ===== */

.cat-main {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx 32rpx;
}

.cat-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg, #fffbf8);
  padding: 32rpx 16rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cat-header__title {
  font-family: var(--font-display, serif);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--fg, #231814);
}

.cat-header__subtitle {
  font-size: 22rpx;
  color: var(--muted, #5a5451);
}

/* ===== 状态 ===== */

.cat-state {
  padding: 64rpx 16rpx;
}

/* ===== 商品 grid(同 2.1)===== */

/* 2 列瀑布:WeChat mp 不生效 display:grid(同 home),改 flex wrap。
   右侧 pane 内 2 列,cell 各占半宽减半个 gap(16rpx)。 */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 0;
}

.cat-grid__cell {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx #231814;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.cat-grid__cell:active {
  transform: scale(0.99);
  box-shadow: 0 1rpx 4rpx #231814;
}

.cat-grid__nav {
  display: flex;
  flex-direction: column;
}

.cat-grid__img {
  width: 100%;
  height: 280rpx;
  background: var(--bg, #fffbf8);
  object-fit: cover;
  display: block;
}

.cat-grid__body {
  padding: 14rpx 18rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cat-grid__name {
  font-size: 26rpx;
  color: var(--fg, #231814);
  line-height: 1.35;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-height: 70rpx;
}

.cat-grid__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}

.cat-grid__price {
  font-family: var(--font-display, serif);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--accent, #db633c);
}

.cat-grid__add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
  box-shadow: 0 4rpx 10rpx #231814;
}

.cat-grid__add--hover {
  background: var(--accent-strong, #b83300);
  transform: scale(0.95);
}

.cat-loadmore,
.cat-nomore {
  padding: 24rpx 0;
  text-align: center;
  color: var(--muted, #5a5451);
  font-size: 24rpx;
}
