<!--
  路线图 3.13 — mp-05 「我的」OD v2 视觉重写。
  tokens 全部走 var(--token, fallback) — 单一源 docs/redesign/tokens.json。
  3 段:用户卡(头像+昵称+角色徽章)+ 4 状态卡(待付款/待发货/待收货/已完成,接 2.6 OrderStatus 4 档)
  + 工具列表(地址管理 / 联系客服 / 关于我们)。
-->
<view class="profile-container">
  <!-- 用户卡 -->
  <view class="user-card">
    <image class="user-avatar" src="{{userInfo ? userInfo.avatarUrl : '/images/default-avatar.png'}}"></image>
    <view class="user-info">
      <text class="user-nickname">{{userInfo ? userInfo.nickname : '点击登录'}}</text>
      <view class="user-role" wx:if="{{userInfo && userInfo.role === 'MERCHANT'}}">
        <text class="role-badge">商家</text>
      </view>
    </view>
  </view>

  <!-- 收藏 / 足迹 数字行(收藏 + 浏览足迹,OD 原型仪表盘惯例;优惠券数字位暂不接入,遗留问题清单已记) -->
  <view class="stats-row">
    <view class="stats-row__item" bindtap="onGoFavorites" hover-class="is-clicked" hover-stay-time="100">
      <text class="stats-row__num">{{favoriteCount}}</text>
      <text class="stats-row__label">收藏</text>
    </view>
    <view class="stats-row__item" bindtap="onGoFootprints" hover-class="is-clicked" hover-stay-time="100">
      <text class="stats-row__num">{{viewCount}}</text>
      <text class="stats-row__label">足迹</text>
    </view>
  </view>

  <!-- 4 状态卡(待付款 / 待发货 / 待收货 / 已完成) -->
  <view class="status-card">
    <view class="status-card__title" bindtap="onGoAllOrders">
      <text>我的订单</text>
      <text class="status-card__more">查看全部 ›</text>
    </view>
    <view class="status-card__grid">
      <navigator
        class="status-item"
        url="/pages-sub/order/order-list/order-list?status=PENDING"
        hover-class="is-clicked"
        hover-stay-time="100"
      >
        <view class="status-item__icon status-item__icon--pending">
          <van-icon name="balance-o" custom-class="status-item__icon-glyph status-item__icon-glyph--pending" />
        </view>
        <text class="status-item__label">待付款</text>
        <view class="status-item__badge" wx:if="{{badges.pending > 0}}">{{badges.pending}}</view>
      </navigator>
      <navigator
        class="status-item"
        url="/pages-sub/order/order-list/order-list?status=PAID"
        hover-class="is-clicked"
        hover-stay-time="100"
      >
        <view class="status-item__icon status-item__icon--paid">
          <van-icon name="gift-o" custom-class="status-item__icon-glyph status-item__icon-glyph--paid" />
        </view>
        <text class="status-item__label">待发货</text>
        <view class="status-item__badge" wx:if="{{badges.paid > 0}}">{{badges.paid}}</view>
      </navigator>
      <navigator
        class="status-item"
        url="/pages-sub/order/order-list/order-list?status=SHIPPED"
        hover-class="is-clicked"
        hover-stay-time="100"
      >
        <view class="status-item__icon status-item__icon--shipped">
          <van-icon name="logistics" custom-class="status-item__icon-glyph status-item__icon-glyph--shipped" />
        </view>
        <text class="status-item__label">待收货</text>
        <view class="status-item__badge" wx:if="{{badges.shipped > 0}}">{{badges.shipped}}</view>
      </navigator>
      <navigator
        class="status-item"
        url="/pages-sub/order/order-list/order-list?status=COMPLETED"
        hover-class="is-clicked"
        hover-stay-time="100"
      >
        <view class="status-item__icon status-item__icon--completed">
          <van-icon name="completed" custom-class="status-item__icon-glyph status-item__icon-glyph--completed" />
        </view>
        <text class="status-item__label">已完成</text>
        <view class="status-item__badge" wx:if="{{badges.completed > 0}}">{{badges.completed}}</view>
      </navigator>
    </view>
  </view>

  <!-- 工具列表 -->
  <view class="tools-card">
    <navigator
      class="tool-item"
      url="/pages-sub/user/address/address-list"
      hover-class="is-clicked"
      hover-stay-time="100"
    >
      <van-icon name="location-o" custom-class="tool-item__icon" />
      <text class="tool-item__label">收货地址</text>
      <text class="tool-item__arrow">›</text>
    </navigator>
    <view class="tool-item" bindtap="onContactService" hover-class="is-clicked" hover-stay-time="100">
      <van-icon name="chat-o" custom-class="tool-item__icon" />
      <text class="tool-item__label">联系客服</text>
      <text class="tool-item__arrow">›</text>
    </view>
    <view class="tool-item" bindtap="onAboutUs" hover-class="is-clicked" hover-stay-time="100">
      <van-icon name="info-o" custom-class="tool-item__icon" />
      <text class="tool-item__label">关于我们</text>
      <text class="tool-item__arrow">›</text>
    </view>
  </view>
</view>
