/*
 * 路线图 3.13 — mp-05 「我的」OD v2 视觉。
 * tokens 单一源 docs/redesign/tokens.json。
 */

.profile-container {
  min-height: 100vh;
  background: var(--bg, #fffbf8);
  padding-bottom: 160rpx;
}

/* ===== 用户卡 ===== */

.user-card {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 44rpx 36rpx;
  background: linear-gradient(135deg, var(--accent-deep, #64230d) 0%, var(--accent-strong, #b83300) 100%);
  border-radius: var(--radius-2xl, 16px);
  box-shadow: 0 4rpx 16rpx #231814;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid var(--surface, #fff);
  background: var(--bg, #fffbf8);
  margin-right: 32rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.user-nickname {
  font-family: var(--font-display, serif);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--surface, #fff);
  line-height: 1.25;
}

.user-role {
  display: flex;
}

.role-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--accent-strong, #b83300);
  background: var(--surface, #fff);
  border-radius: var(--radius-pill, 9999px);
}

/* ===== 4 状态卡 ===== */

.status-card {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 28rpx 32rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx #231814;
}

.status-card__title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  font-family: var(--font-display, serif);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg, #231814);
}

.status-card__more {
  font-family: var(--font-body, sans-serif);
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted, #5a5451);
}

.status-card__grid {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.status-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.status-item__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-item__icon--pending { background: var(--warning-soft, #fff0d4); }
.status-item__icon--paid { background: var(--info-soft, #d8f8ff); }
.status-item__icon--shipped { background: var(--accent-soft, #ffe7d9); }
.status-item__icon--completed { background: var(--success-soft, #e2f9e2); }

.status-item__icon-glyph {
  font-size: 44rpx;
  line-height: 1;
}

.status-item__icon-glyph--pending { color: var(--warning, #df911a); }
.status-item__icon-glyph--paid { color: var(--info, #1988a3); }
.status-item__icon-glyph--shipped { color: var(--accent, #db633c); }
.status-item__icon-glyph--completed { color: var(--success, #318f5a); }

.status-item__label {
  font-size: 24rpx;
  color: var(--fg, #231814);
  line-height: 1.2;
}

.status-item__badge {
  position: absolute;
  top: 0rpx;
  right: 32rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill, 9999px);
  background: var(--error, #df202e);
  color: var(--surface, #fff);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 4rpx #231814;
}

/* ===== 工具列表 ===== */

.tools-card {
  margin: 24rpx 24rpx 0;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx #231814;
  overflow: hidden;
}

.tool-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border, #eae3e1);
}

.tool-item:last-child {
  border-bottom: none;
}

.tool-item__icon {
  font-size: 36rpx;
  color: var(--accent, #db633c);
  line-height: 1;
}

.tool-item__label {
  flex: 1;
  font-size: 28rpx;
  color: var(--fg, #231814);
  line-height: 1.3;
}

.tool-item__arrow {
  font-size: 36rpx;
  color: var(--muted, #857f7d);
  line-height: 1;
}
