/*
 * 路线图 2.4 — mp-04 购物车 OD v2 视觉。
 * tokens 单一源 docs/redesign/tokens.json。
 */

.cart-container {
  min-height: 100vh;
  background: var(--bg, #fffbf8);
  padding-bottom: 160rpx; /* 给 sticky footer 留位置 */
}

.cart-empty {
  padding: 120rpx 32rpx;
}

/* ===== 收货地址卡 ===== */

.cart-address {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx #231814;
}

.cart-address__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.cart-address__head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.cart-address__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg, #231814);
}

.cart-address__phone {
  font-size: 26rpx;
  color: var(--muted, #5a5451);
}

.cart-address__detail {
  font-size: 26rpx;
  color: var(--muted, #5a5451);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-address__empty {
  flex: 1;
}

.cart-address__placeholder {
  font-size: 28rpx;
  color: var(--muted, #5a5451);
}

.cart-address__arrow {
  font-size: 48rpx;
  color: var(--muted, #857f7d);
  margin-left: 16rpx;
  line-height: 1;
}

/* ===== 全选栏 ===== */

.cart-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 16rpx;
  padding: 16rpx 20rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx #231814;
}

.cart-bar__select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cart-bar__label {
  font-size: 28rpx;
  color: var(--fg, #231814);
}

.cart-bar__count {
  font-size: 24rpx;
  color: var(--muted, #5a5451);
}

/* 自绘 checkbox(避免原生 checkbox 在 mp 端样式不可控) */

.cart-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--bg, #fffbf8);
  box-shadow: inset 0 0 0 2rpx var(--border-strong, #d5cbc8);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.18s ease, box-shadow 0.18s ease;
}

.cart-checkbox--checked {
  background: var(--accent, #db633c);
  box-shadow: 0 2rpx 6rpx #231814;
}

.cart-checkbox__icon {
  color: var(--surface, #fff);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
}

/* ===== 商品列表 ===== */

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 24rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx #231814;
}

.cart-item__check {
  flex-shrink: 0;
}

.cart-item__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-lg, 10px);
  background: var(--bg, #fffbf8);
  flex-shrink: 0;
  object-fit: cover;
}

.cart-item__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cart-item__name {
  font-size: 28rpx;
  color: var(--fg, #231814);
  font-weight: 500;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.cart-item__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-item__price {
  font-family: var(--font-display, serif);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--accent, #db633c);
}

.cart-stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cart-stepper__btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg, #fffbf8);
  color: var(--fg, #231814);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 300;
  box-shadow: inset 0 0 0 1rpx var(--border, #eae3e1);
}

.cart-stepper__btn--hover {
  background: var(--accent-soft, #ffe7d9);
  color: var(--accent-strong, #b83300);
}

.cart-stepper__btn.is-disabled {
  opacity: 0.3;
}

.cart-stepper__value {
  font-family: var(--font-display, serif);
  font-size: 28rpx;
  min-width: 50rpx;
  text-align: center;
  color: var(--fg, #231814);
}

.cart-item__remove {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: transparent;
  color: var(--muted, #857f7d);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
  flex-shrink: 0;
}

.cart-item__remove--hover {
  background: var(--error-soft, #ffe8e4);
  color: var(--error, #df202e);
}

/* ===== 订单信息 ===== */

.cart-summary {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx #231814;
}

.cart-summary__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.cart-summary__label {
  font-size: 28rpx;
  color: var(--muted, #5a5451);
}

.cart-summary__value {
  font-size: 28rpx;
  color: var(--fg, #231814);
  font-weight: 500;
}

.cart-summary__free {
  color: var(--success, #31983d);
}

/* ===== 底部结算 bar(sticky) ===== */

.cart-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface, #fff);
  padding: 20rpx 32rpx;
  box-shadow: 0 -2rpx 12rpx #231814;
}

.cart-footer__left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.cart-footer__total-label {
  font-size: 26rpx;
  color: var(--muted, #5a5451);
}

.cart-footer__total-price {
  font-family: var(--font-display, serif);
  font-size: 40rpx;
  font-weight: 600;
  color: var(--accent, #db633c);
  line-height: 1;
}

.cart-footer__checkout {
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 36rpx;
  border-radius: var(--radius-pill, 9999px);
  box-shadow: 0 4rpx 12rpx #231814;
}

.cart-footer__checkout.is-disabled {
  background: var(--muted, #857f7d);
  box-shadow: none;
  opacity: 0.5;
}
