/*
 * 路线图 2.1 — mp-01 首页 OD v2 视觉。
 * tokens 单一源 docs/redesign/tokens.json(由 scripts/build-tokens.js 派生为
 * frontend/src/shared/tokens/tokens.wxss,这里 var(--token, fallback) 引用)。
 */

.home-container {
  min-height: 100vh;
  background: var(--bg, #fffbf8);
  padding-bottom: 32rpx;
}

/* ===== Banner ===== */

.home-banner {
  width: 100%;
  height: 320rpx;
  margin-top: 16rpx;
}

.home-banner__item {
  width: calc(100% - 48rpx);
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 48rpx;
  border-radius: var(--radius-xl, 14px);
  margin: 0 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx #231814;
}

.home-banner__item--accent {
  background: linear-gradient(135deg, var(--accent, #db633c), var(--accent-deep, #a11400));
  color: var(--surface, #fff);
}

.home-banner__item--soft {
  background: var(--accent-soft, #ffe7d9);
  color: var(--fg, #231814);
}

.home-banner__emoji {
  font-size: 96rpx;
  margin-right: 32rpx;
}

.home-banner__copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.home-banner__title {
  font-family: var(--font-display, serif);
  font-size: 40rpx;
  font-weight: 600;
}

.home-banner__subtitle {
  font-size: 26rpx;
  opacity: 0.85;
}

/* ===== 分类 chips(横向 scroll) ===== */

.home-chips {
  white-space: nowrap;
  padding: 24rpx 24rpx 8rpx;
  background: var(--bg, #fffbf8);
  /* v2.1 signoff 修:Skyline 渲染下 scroll-view scroll-x 默认 overflow:hidden,
     需显式设 overflow-x:auto + 不收缩,否则 inline-flex chips 仍会按 block 排
     版重叠(用 white-space:nowrap 单独不够,scroll-view 不是 inline container) */
  display: block;
  overflow-x: auto;
  overflow-y: hidden;
}

.home-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  background: var(--surface, #fff);
  color: var(--muted, #5a5451);
  border-radius: var(--radius-pill, 9999px);
  font-size: 26rpx;
  box-shadow: inset 0 0 0 1rpx var(--border, #eae3e1);
  transition: background 0.18s ease, color 0.18s ease;
}

.home-chip--active {
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  box-shadow: 0 4rpx 12rpx #231814;
}

.home-chip__emoji {
  margin-right: 8rpx;
  font-size: 28rpx;
}

/* ===== Section header ===== */

.home-section-header {
  padding: 32rpx 32rpx 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.home-section-title {
  font-family: var(--font-display, serif);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--fg, #231814);
}

.home-section-subtitle {
  font-size: 24rpx;
  color: var(--muted, #5a5451);
}

/* ===== 状态(loading / error / empty) ===== */

.home-state {
  padding: 64rpx 32rpx;
}

/* ===== 商品 2 列 grid ===== */

.home-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 16rpx;
}

.home-grid__cell {
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx #231814;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.home-grid__cell:active {
  transform: scale(0.99);
  box-shadow: 0 1rpx 4rpx #231814;
}

.home-grid__nav {
  display: flex;
  flex-direction: column;
}

.home-grid__img {
  width: 100%;
  height: 320rpx;
  background: var(--bg, #fffbf8);
  object-fit: cover;
  display: block;
}

.home-grid__body {
  padding: 16rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.home-grid__name {
  font-size: 28rpx;
  color: var(--fg, #231814);
  line-height: 1.35;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-height: 76rpx;
}

.home-grid__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.home-grid__price {
  font-family: var(--font-display, serif);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--accent, #db633c);
}

.home-grid__add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
  box-shadow: 0 4rpx 12rpx #231814;
}

.home-grid__add--hover {
  background: var(--accent-strong, #b83300);
  transform: scale(0.95);
}

/* ===== 加载更多 / 没有了 ===== */

.home-loadmore,
.home-nomore {
  padding: 32rpx 0;
  text-align: center;
  color: var(--muted, #5a5451);
  font-size: 24rpx;
}

.home-nomore text {
  letter-spacing: 0.5rpx;
}
