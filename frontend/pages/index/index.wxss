/*
 * mp-01 首页 —— 对齐 OD 原型(openspec change mp-od-prototype-alignment)。
 * 唯一真值 = frontend/e2e/od-golden/mp-01-home.png。
 * tokens 单一源 docs/redesign/tokens.json(由 scripts/build-tokens.js 派生为
 * frontend/src/shared/tokens/tokens.wxss,这里 var(--token, fallback) 引用)。
 */

.home-container {
  min-height: 100vh;
  background: var(--bg, #fffbf8);
  padding-bottom: 32rpx;
}

/* ===== ① 定位 + 通知 + 搜索 ===== */

.home-header {
  padding: 16rpx 32rpx 0;
}

.home-location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-location {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.home-location__icon {
  font-size: 24rpx;
}

.home-location__text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--fg, #231814);
}

.home-bell {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-pill, 9999px);
  background: var(--surface, #fff);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.home-bell__icon {
  font-size: 32rpx;
}

.home-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  margin-top: 20rpx;
  padding: 0 28rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-pill, 9999px);
  box-shadow: inset 0 0 0 1rpx var(--border, #e6e0dd);
  box-sizing: border-box;
}

.home-search__icon {
  font-size: 28rpx;
  color: var(--muted, #6b615d);
}

.home-search__input {
  flex: 1;
  font-size: 26rpx;
  color: var(--fg, #231814);
}

.home-search__btn {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent, #db633c);
}

/* ===== ② Hero banner(深色沉浸卡片,前端近似) ===== */

.home-banner {
  width: 100%;
  height: 320rpx;
  margin-top: 24rpx;
}

.home-banner__item {
  position: relative;
  width: calc(100% - 48rpx);
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 48rpx;
  border-radius: var(--radius-xl, 14px);
  margin: 0 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx var(--shadow-md, rgba(35, 24, 20, 0.07));
}

/* OD 只展示一种深色沉浸风格;accent/soft 两个 tone 都收敛到 accent-deep,
   不编造后端没有的字段(brief §2 —— 只做前端近似,不改 Banner 领域模型)。 */
.home-banner__item--accent,
.home-banner__item--soft {
  background: var(--accent-deep, #64230d);
  color: var(--surface, #fff);
}

.home-banner__emoji {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 40rpx;
  opacity: 0.55;
}

.home-banner__copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  max-width: 78%;
}

.home-banner__title {
  font-family: var(--font-display, serif);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.home-banner__subtitle {
  font-size: 26rpx;
  opacity: 0.8;
}

/* ===== ③ 5 分类圆形导航(横向 scroll) ===== */

.home-category-row {
  white-space: nowrap;
  padding: 32rpx 24rpx 8rpx;
  background: var(--bg, #fffbf8);
  /* v2.1 signoff 修:Skyline 渲染下 scroll-view scroll-x 默认 overflow:hidden,
     需显式设 overflow-x:auto + 不收缩,否则 inline-flex 子项仍会按 block 排
     版重叠(用 white-space:nowrap 单独不够,scroll-view 不是 inline container) */
  display: block;
  overflow-x: auto;
  overflow-y: hidden;
}

.home-category {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 112rpx;
  margin-right: 24rpx;
}

.home-category:last-child {
  margin-right: 0;
}

.home-category__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-pill, 9999px);
  background: var(--surface, #fff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.home-category__label {
  font-size: 24rpx;
  color: var(--fg, #231814);
  text-align: center;
}

/* ===== ⑤ Section header("今日 {N} 款推荐" + 查看全部) ===== */

.home-section-header {
  padding: 32rpx 32rpx 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.home-section-title {
  font-family: var(--font-display, serif);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--fg, #231814);
}

.home-section-title__count {
  color: var(--accent, #db633c);
}

.home-section-link {
  font-size: 24rpx;
  color: var(--muted, #5a5451);
}

/* ===== ④ Filter chip 行(只有"全部"功能性,其余 3 项占位) ===== */

.home-chips {
  white-space: nowrap;
  padding: 8rpx 24rpx 8rpx;
  background: var(--bg, #fffbf8);
  display: block;
  overflow-x: auto;
  overflow-y: hidden;
}

.home-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  background: var(--surface, #fff);
  color: var(--muted, #5a5451);
  border-radius: var(--radius-pill, 9999px);
  font-size: 26rpx;
  box-shadow: inset 0 0 0 1rpx var(--border, #eae3e1);
  transition: background 0.18s ease, color 0.18s ease;
}

/* "全部" 激活态用 --fg 深色实底(贴近 OD),其余 3 个占位 chip 永远不激活。 */
.home-chip--active {
  background: var(--fg, #231814);
  color: var(--surface, #fff);
  box-shadow: 0 4rpx 12rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.home-chip__label {
  font-size: 26rpx;
}

/* ===== 状态(loading / error / empty) ===== */

.home-state {
  padding: 64rpx 32rpx;
}

/* ===== 商品 2 列 grid ===== */

/* 2 列瀑布:WeChat mp(libVersion 3.15.1)不生效 display:grid → 退化单列,
   改 flex wrap(mp 惯用 2 列模式)。列间距 16rpx,cell 各占半宽减半个 gap。 */
.home-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 16rpx;
}

.home-grid__cell {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.home-grid__cell:active {
  transform: scale(0.99);
  box-shadow: 0 1rpx 4rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.home-grid__nav {
  display: flex;
  flex-direction: column;
}

.home-grid__img {
  width: 100%;
  height: 320rpx;
  background: var(--bg, #fffbf8);
  object-fit: cover;
  display: block;
}

.home-grid__body {
  padding: 16rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.home-grid__name {
  font-size: 28rpx;
  color: var(--fg, #231814);
  line-height: 1.35;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-height: 76rpx;
}

.home-grid__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.home-grid__price {
  font-family: var(--font-display, serif);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--accent, #db633c);
}

.home-grid__add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
  box-shadow: 0 4rpx 12rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.home-grid__add--hover {
  background: var(--accent-strong, #b83300);
  transform: scale(0.95);
}

/* ===== 加载更多 / 没有了 ===== */

.home-loadmore,
.home-nomore {
  padding: 32rpx 0;
  text-align: center;
  color: var(--muted, #5a5451);
  font-size: 24rpx;
}

.home-nomore text {
  letter-spacing: 0.5rpx;
}
