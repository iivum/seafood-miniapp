/*
 * 路线图 2.3 — mp-03 商品详情 OD v2 视觉。
 * tokens 单一源 docs/redesign/tokens.json。
 *
 * mp-03 OD 原型对齐(openspec change mp-od-prototype-alignment,brief
 * `.superpowers/sdd/mp-od-3-product-detail-brief.md`):新增 .detail-hero /
 * .detail-topbar(悬浮顶栏,brief §1);.detail-info / .detail-footer 的
 * box-shadow 此前裸写 var(--shadow-sm, rgba(35, 24, 20, 0.05))(违反"不裸写 hex"约束),改成 var(--shadow-*,
 * fallback) 形式,与 mp-01/mp-02(index.wxss / category.wxss)token 用法惯例
 * 对齐(brief §2/§3)。
 */

.detail-container {
  min-height: 100vh;
  background: var(--bg, #fffbf8);
  padding-bottom: 180rpx; /* 给 sticky footer 留位置 */
}

/* ===== 大图(通顶无圆角)+ 悬浮顶栏(brief §1)===== */

.detail-hero {
  position: relative;
}

.detail-image {
  width: 100%;
  height: 750rpx;
  background: var(--bg, #f8f0ea);
  display: block;
}

.detail-topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 0;
  /* 顶部渐隐暗色 scrim,保证按钮在任意图片亮度下都可辨识(纯视觉legibility手法,
     不是编造数据)。35,24,20 是 --fg(#231814)分解值,tokens.wxss 未定义
     scrim/overlay 专用 token(--shadow-* 家族透明度是给 box-shadow 用的,
     不适合这里需要的更高不透明度),裸写 rgba 是既定接受的例外(同 mp-01
     首页 swiper indicator-color 的既有先例),非本次改动引入新违规。 */
  background: linear-gradient(to bottom, rgba(35, 24, 20, 0.35), rgba(35, 24, 20, 0));
}

.detail-topbar__actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-topbar__btn {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: var(--radius-pill, 9999px);
  background: rgba(35, 24, 20, 0.35); /* --fg 分解值,同上方 scrim 注释的既定例外 */
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/*
 * 分享按钮必须是原生 <button open-type="share"> 才能触发小程序分享面板,
 * 但原生 button 组件自带一个远大于内容的默认盒子(实测 184rpx×宽,不受
 * width/min-width 覆盖)。做法:button 本身重置成"无视觉痕迹"的透明壳,
 * 真正的圆形按钮外观放在里面一层 .detail-topbar__btn(view)上。
 */
.detail-topbar__btn-reset {
  width: auto;
  height: auto;
  min-width: 0;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  font-size: 0;
}

.detail-topbar__btn-reset::after {
  border: none;
}

.detail-topbar__icon {
  font-size: 32rpx;
  line-height: 1;
  color: var(--surface, #fff);
}

/* ===== 商品信息卡 ===== */

.detail-info {
  margin: -32rpx 24rpx 0;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  padding: 32rpx 32rpx 40rpx;
  position: relative;
  z-index: 1;
  box-shadow: 0 2rpx 10rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-info__price {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.detail-info__currency {
  font-family: var(--font-display, serif);
  font-size: 28rpx;
  color: var(--accent, #db633c);
  font-weight: 500;
}

.detail-info__amount {
  font-family: var(--font-display, serif);
  font-size: 56rpx;
  font-weight: 600;
  color: var(--accent, #db633c);
  line-height: 1;
}

.detail-info__name {
  font-family: var(--font-display, serif);
  font-size: 38rpx;
  font-weight: 600;
  color: var(--fg, #231814);
  line-height: 1.35;
}

.detail-info__desc {
  font-size: 28rpx;
  color: var(--muted, #5a5451);
  line-height: 1.5;
}

/* ===== 商品参数 + stepper ===== */

.detail-section {
  margin: 24rpx 24rpx 0;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  padding: 8rpx 32rpx;
  box-shadow: 0 2rpx 10rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.detail-section__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border, #eae3e1);
}

.detail-section__row:last-child {
  border-bottom: none;
}

.detail-section__label {
  font-size: 28rpx;
  color: var(--muted, #5a5451);
}

.detail-section__value {
  font-size: 28rpx;
  color: var(--fg, #231814);
  font-weight: 500;
}

/* stepper */

.detail-stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-stepper__btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg, #fffbf8);
  color: var(--fg, #231814);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
  box-shadow: inset 0 0 0 1rpx var(--border, #eae3e1);
}

.detail-stepper__btn--hover {
  background: var(--accent-soft, #ffe7d9);
  color: var(--accent-strong, #b83300);
}

.detail-stepper__btn.is-disabled {
  opacity: 0.3;
}

.detail-stepper__value {
  font-family: var(--font-display, serif);
  font-size: 32rpx;
  font-weight: 500;
  min-width: 60rpx;
  text-align: center;
  color: var(--fg, #231814);
}

/* ===== 推荐 ===== */

.detail-recommend {
  margin: 24rpx 24rpx 0;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  padding: 24rpx 0;
  box-shadow: 0 2rpx 10rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.detail-recommend__header {
  padding: 0 24rpx 16rpx;
}

.detail-recommend__title {
  font-family: var(--font-display, serif);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg, #231814);
}

.detail-recommend__scroll {
  white-space: nowrap;
  padding: 0 16rpx;
}

.detail-recommend__item {
  display: inline-block;
  width: 220rpx;
  margin: 0 8rpx;
  vertical-align: top;
}

.detail-recommend__img {
  width: 220rpx;
  height: 220rpx;
  border-radius: var(--radius-lg, 10px);
  background: var(--bg, #fffbf8);
  object-fit: cover;
  display: block;
}

.detail-recommend__name {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--fg, #231814);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-recommend__price {
  display: block;
  margin-top: 4rpx;
  font-family: var(--font-display, serif);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent, #db633c);
}

.detail-state {
  padding: 24rpx 0;
  text-align: center;
}

/* ===== 底部 sticky 3-button bar ===== */

.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  background: var(--surface, #fff);
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx var(--shadow-md, rgba(35, 24, 20, 0.07));
}

.detail-footer__side {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.detail-footer__side-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  width: 96rpx;
  height: 80rpx;
  border-radius: var(--radius-md, 6px);
  transition: background 0.18s ease;
}

.detail-footer__side-btn--hover {
  background: var(--bg, #fffbf8);
}

.detail-footer__side-icon {
  font-size: 32rpx;
  line-height: 1;
  color: var(--muted, #6b615d);
}

.detail-footer__side-btn.is-fav .detail-footer__side-icon {
  color: var(--accent, #db633c);
}

.detail-footer__side-label {
  font-size: 20rpx;
  line-height: 1;
  color: var(--muted, #6b615d);
  margin-top: 4rpx;
}

.detail-footer__main {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.detail-footer__btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-pill, 9999px);
  transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease;
  line-height: 1;
}

.detail-footer__btn--cart {
  background: var(--accent-soft, #ffe7d9);
  color: var(--accent-strong, #b83300);
  box-shadow: 0 2rpx 8rpx rgba(219, 99, 60, 0.18);
}

.detail-footer__btn--buy {
  /* sprint 2 WCAG 修:fg=surface(#fff) 在 accent(#db633c) ratio=3.58 失败。
     改用 accent-strong(#b83300) → ratio 5.98,达 AA 4.5+ */
  background: var(--accent-strong, #b83300);
  color: var(--surface, #fff);
  box-shadow: 0 4rpx 12rpx rgba(184, 51, 0, 0.32);
}

.detail-footer__btn--hover {
  transform: scale(0.97);
}
