/*
 * sprint-1-closure mp-09 订单详情页 OD v2 视觉。
 * tokens 单一源 docs/redesign/tokens.json。
 *
 * mp-cross-screen-cleanup design.md D3:类名从扁平缩写 + 嵌套选择器
 * (如原 `.addr-card .row1`)改为 BEM 扁平类名(block__element--modifier),
 * 与 order-list.wxss 的 .order-card__xxx 风格对齐。规则内容/视觉不变,
 * 纯选择器改名 + 拍平嵌套依赖。
 */

.order-detail {
  min-height: 100vh;
  background: var(--bg, #fffbf8);
  padding-bottom: 200rpx;
}

.order-detail__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: var(--surface, #ffffff);
  border-bottom: 1rpx solid var(--border, #e6e0dd);
}
.order-detail__back { font-size: 48rpx; line-height: 1; padding: 8rpx 16rpx; }
.order-detail__title { font-size: 32rpx; font-weight: 600; }
.order-detail__placeholder { width: 64rpx; }

.order-detail__loading, .order-detail__error, .order-detail__empty {
  display: flex; align-items: center; justify-content: center;
  min-height: 400rpx; padding: 48rpx;
}
.order-detail__error-msg { color: var(--error, #b9003d); font-size: 28rpx; margin-bottom: 24rpx; }
.order-detail__retry-btn {
  background: var(--accent, #db633c); color: var(--shell, #ffffff);
  border: 0; border-radius: 12rpx; padding: 16rpx 48rpx; font-size: 28rpx;
}

.order-detail__banner {
  margin: 24rpx 32rpx 0; padding: 32rpx;
  border-radius: 20rpx;
}
.order-detail__banner--success { background: var(--success-soft, #d5f9e0); }
.order-detail__banner--info    { background: var(--info-soft, #d2f5ff); }
.order-detail__banner--warning { background: var(--warning-soft, #ffe9cb); }
.order-detail__banner--error   { background: var(--error-soft, #ffe2e4); }
.order-detail__banner--neutral { background: var(--bg, #f5efe8); }
.order-detail__banner-eyebrow { font-size: 22rpx; color: var(--muted, #6b615d); margin-bottom: 8rpx; }
.order-detail__banner-title { font-size: 40rpx; font-weight: 600; margin-bottom: 8rpx; }
.order-detail__banner-sub { font-size: 26rpx; color: var(--muted, #6b615d); }

.order-detail__card { margin: 24rpx 32rpx 0; background: var(--surface, #ffffff); border: 1rpx solid var(--border, #e6e0dd); border-radius: 20rpx; padding: 32rpx; }
.order-detail__card-title { font-size: 24rpx; font-weight: 600; color: var(--muted, #6b615d); margin-bottom: 16rpx; letter-spacing: 0.1em; text-transform: uppercase; }

/* mp-09 接线 order-tracking-timeline 组件后,旧 .timeline/.tl-node 硬编码样式已不再使用
   (组件自带 index.wxss,同 order-action-row 惯例——不在宿主页面重复定义)。 */

.order-detail__address-row { display: flex; gap: 16rpx; margin-bottom: 12rpx; }
.order-detail__address-name { font-size: 30rpx; font-weight: 600; }
.order-detail__address-note { font-size: 28rpx; line-height: 1.5; }

.order-detail__item { display: flex; gap: 24rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--border, #e6e0dd); }
.order-detail__item:last-child { border-bottom: 0; }
.order-detail__item-pic { width: 120rpx; height: 120rpx; background: var(--bg, #f5efe8); border-radius: 12rpx; flex-shrink: 0; }
.order-detail__item-info { flex: 1; }
.order-detail__item-name { font-size: 28rpx; font-weight: 500; }
.order-detail__item-spec { font-size: 24rpx; color: var(--muted, #6b615d); margin-top: 4rpx; }
.order-detail__item-price { text-align: right; }
.order-detail__item-price-value { font-size: 28rpx; font-weight: 600; }

.order-detail__price-row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.order-detail__price-label { font-size: 28rpx; color: var(--muted, #6b615d); }
.order-detail__price-value { font-size: 28rpx; }

.order-detail__info-row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.order-detail__info-label { font-size: 26rpx; color: var(--muted, #6b615d); }
.order-detail__info-value { font-size: 26rpx; font-family: var(--font-mono, monospace); }

.order-detail__bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; gap: 16rpx;
  padding: 24rpx 32rpx 48rpx;
  background: var(--surface, #ffffff);
  border-top: 1rpx solid var(--border, #e6e0dd);
}
/* mp-09 接线 order-action-row 组件后,旧 .bottom-bar .act 硬编码 3 按钮样式已不再使用
   (按钮 variant 配色由组件自带 index.wxss 负责)。 */
