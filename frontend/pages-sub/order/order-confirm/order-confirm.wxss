/*
 * 路线图 3.14 / 3.17 / 3.18 — mp-06 订单确认 OD v2 视觉。
 * 5 段:地址 / 商品 / 配送 / 备注 / 金额明细 + 底部结算 sticky。
 * tokens 单一源 docs/redesign/tokens.json。
 *
 * mp-06 OD 原型对齐(brief `.superpowers/sdd/mp-od-5-order-confirm-brief.md`):
 * 新增 .confirm-topbar(brief §1,与 order-detail.wxss 的 .topbar / mp-02
 * category.wxss 的 .cat-topbar 同款圆角/间距/token 惯例)+ .summary-count
 * (brief §3 "共 N 件",复用 .remark-counter 同款次要文案字号/颜色惯例)。
 */

.order-confirm-container {
  min-height: 100vh;
  background: var(--bg, #fffbf8);
  padding-bottom: 180rpx;
}

/* ===== 0. 顶部标题栏(brief §1;navigationStyle:custom 替代原生导航栏) ===== */

.confirm-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx;
  background: var(--bg, #fffbf8);
}

.confirm-topbar__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-pill, 9999px);
  background: var(--surface, #fff);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.confirm-topbar__back-icon {
  font-size: 36rpx;
  color: var(--fg, #231814);
  line-height: 1;
}

.confirm-topbar__title {
  font-family: var(--font-display, serif);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--fg, #231814);
}

.confirm-topbar__placeholder {
  width: 64rpx;
  height: 64rpx;
}

.card-title {
  font-family: var(--font-display, serif);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg, #231814);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* brief §3 "共 N 件"(金额明细卡标题行,同 .remark-counter 次要文案惯例) */
.summary-count {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted, #5a5451);
  font-family: var(--font-body, -apple-system, BlinkMacSystemFont, sans-serif);
}

/* ===== 1. 地址选择器 ===== */

.address-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 0;
  padding: 32rpx 28rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.address-card__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.address-card__head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.address-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg, #231814);
  line-height: 1.3;
}

.address-card__phone {
  font-size: 26rpx;
  color: var(--muted, #5a5451);
}

.address-card__detail {
  font-size: 26rpx;
  color: var(--muted, #5a5451);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.address-card__empty {
  flex: 1;
}

.address-card__placeholder {
  font-size: 28rpx;
  color: var(--muted, #5a5451);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.address-card__arrow {
  font-size: 48rpx;
  color: var(--muted, #857f7d);
  margin-left: 16rpx;
  line-height: 1;
}

/* ===== 2. 商品清单 ===== */

.items-card {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.items-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-lg, 10px);
  background: var(--bg, #fffbf8);
  object-fit: cover;
  flex-shrink: 0;
}

.item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.item__name {
  font-size: 28rpx;
  color: var(--fg, #231814);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item__price {
  font-family: var(--font-display, serif);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--accent, #db633c);
}

.item__qty {
  font-size: 26rpx;
  color: var(--muted, #5a5451);
}

/* ===== 3. 配送方式 ===== */

.delivery-card {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.delivery-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.delivery-option {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--bg, #fffbf8);
  border-radius: var(--radius-lg, 10px);
  box-shadow: inset 0 0 0 2rpx var(--border, #eae3e1);
  transition: box-shadow 0.18s ease, background 0.18s ease;
}

.delivery-option.is-selected {
  background: var(--accent-soft, #ffe7d9);
  box-shadow: inset 0 0 0 2rpx var(--accent, #db633c);
}

.delivery-option__name {
  font-size: 28rpx;
  color: var(--fg, #231814);
  font-weight: 500;
}

.delivery-option__fee {
  font-family: var(--font-display, serif);
  font-size: 26rpx;
  color: var(--muted, #5a5451);
}

.delivery-option.is-selected .delivery-option__fee {
  color: var(--accent, #db633c);
  font-weight: 600;
  /* 给 absolute 定位的勾选徽章(right:16rpx + 宽 36rpx)让位,防遮挡费用 */
  margin-right: 60rpx;
}

.delivery-option__check {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  margin-left: 12rpx;
}

/* ===== 4. 备注 ===== */

.remark-card {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.remark-counter {
  font-size: 24rpx;
  color: var(--muted, #5a5451);
  font-weight: 400;
  font-family: var(--font-body, -apple-system, BlinkMacSystemFont, sans-serif);
}

.remark-counter.is-warning {
  color: var(--warning, #e58212);
  font-weight: 600;
}

.remark-input {
  width: 100%;
  min-height: 100rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--fg, #231814);
  background: var(--bg, #fffbf8);
  border-radius: var(--radius-lg, 10px);
  box-shadow: inset 0 0 0 1rpx var(--border, #eae3e1);
  line-height: 1.5;
  box-sizing: border-box;
}

/* ===== 5. 金额明细 ===== */

.summary-card {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.summary-row__label {
  font-size: 28rpx;
  color: var(--muted, #5a5451);
}

.summary-row__value {
  font-family: var(--font-display, serif);
  font-size: 28rpx;
  color: var(--fg, #231814);
}

.summary-row__free {
  color: var(--success, #31983d);
}

.summary-row__discount {
  color: var(--error, #df202e);
}

.summary-row--total {
  border-top: 1rpx solid var(--border, #eae3e1);
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.summary-row--total .summary-row__label {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--fg, #231814);
}

.summary-row__total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent, #db633c);
}

/* ===== 底部结算 sticky ===== */

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface, #fff);
  padding: 20rpx 32rpx;
  box-shadow: 0 -2rpx 12rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.bottom-bar__left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.bottom-bar__total-label {
  font-size: 26rpx;
  color: var(--muted, #5a5451);
}

.bottom-bar__total-price {
  font-family: var(--font-display, serif);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent, #db633c);
  line-height: 1;
}

.bottom-bar__submit {
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: var(--radius-pill, 9999px);
  box-shadow: 0 4rpx 12rpx var(--shadow-sm, rgba(35, 24, 20, 0.05));
}

.bottom-bar__submit.is-disabled {
  background: var(--muted, #857f7d);
  box-shadow: none;
  opacity: 0.5;
}
