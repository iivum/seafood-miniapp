/*
 * 登录页 —— 对齐 OD mp-10-login.html(openspec change align-mp-login-with-od)。
 * 颜色/圆角复用全局共享 token(frontend/src/shared/tokens/tokens.wxss,
 * 由 app.wxss 注入到 page 根,这里 var(--token, fallback) 引用,不重复定义)。
 */

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg, #fffbf8);
}

/* hero 视觉区 —— 暂无产品实拍图素材,用品牌暖色渐变代替 OD 原型里的照片背景 */
.login-hero {
  position: relative;
  height: 420rpx;
  flex: none;
  background: linear-gradient(135deg, var(--accent-deep, #64230d) 0%, var(--accent, #db633c) 100%);
  overflow: hidden;
}

.login-hero-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0.04) 45%, var(--bg, #fffbf8) 100%);
}

.login-brand {
  position: absolute;
  left: 48rpx;
  bottom: 64rpx;
  z-index: 1;
  color: #fffdf9;
}

.login-brand-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.login-brand-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-md, 6px);
  background: rgba(255, 255, 255, 0.16);
}

.login-brand-name {
  font-size: 30rpx;
  font-weight: 500;
}

.login-brand-eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  opacity: 0.82;
  margin-bottom: 8rpx;
}

.login-brand-headline {
  display: block;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.32;
  white-space: pre-line;
  max-width: 480rpx;
}

/* 面板区 */
.login-panel {
  flex: 1;
  padding: 44rpx 48rpx 0;
  display: flex;
  flex-direction: column;
}

.login-lede {
  font-size: 25rpx;
  color: var(--muted, #6b615d);
  line-height: 1.5;
  margin-bottom: 40rpx;
}

/* 协议勾选 */
.login-consent {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.login-consent-box {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 3rpx solid var(--border-strong, #d5cbc8);
  margin-top: 2rpx;
  box-sizing: border-box;
  transition: background 0.15s, border-color 0.15s;
}

.login-consent-box.is-checked {
  background: var(--accent, #db633c);
  border-color: var(--accent, #db633c);
}

.login-consent-text {
  font-size: 23rpx;
  color: var(--muted, #6b615d);
  line-height: 1.55;
}

.login-consent.is-shaking {
  animation: login-shake 0.4s;
}

@keyframes login-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

/* 按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-pill, 9999px);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.login-btn--wechat,
.login-btn--phone {
  background: var(--accent, #db633c);
  color: #fffdf9;
}

.login-btn--wechat:active,
.login-btn--phone:active {
  background: var(--accent-strong, #b83300);
}

.login-skip {
  display: block;
  text-align: center;
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--muted, #6b615d);
}

.login-tip {
  display: block;
  text-align: center;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--soft, #a59c99);
}

.login-dev-link {
  display: block;
  text-align: center;
  margin-top: 40rpx;
  font-size: 22rpx;
  color: var(--soft, #a59c99);
}

/* Step2 — 微信授权成功后的头像行 */
.login-avatar-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--success-soft, #d5f9e0);
  border-radius: var(--radius-xl, 14px);
  margin-bottom: 36rpx;
}

.login-avatar {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--accent, #db633c);
  color: #fffdf9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.login-avatar-info {
  flex: 1;
  min-width: 0;
}

.login-avatar-name {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--fg, #231814);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-avatar-sub {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 21rpx;
  color: var(--success, #318f5a);
  margin-top: 4rpx;
}

.is-clicked {
  opacity: 0.85;
}
