<view class="login-page">
  <image class="login-logo" src="/images/logo.png" mode="aspectFit" />
  <text class="login-title">海鲜生鲜商城</text>
  <text class="login-subtitle">登录后开始购物</text>

  <view class="login-actions">
    <!-- 开发者登录:本地 + e2e 用,后端 dev-login(code 以 dev- 开头即走通) -->
    <button
      class="login-btn login-btn--dev"
      bindtap="onDevLogin"
      hover-class="is-clicked"
      hover-stay-time="100"
    >
      <icon type="download" size="20" />
      <text>开发者登录</text>
    </button>

    <!-- 微信登录:真机扫码,后端走 wx.login code → jscode2session -->
    <button
      class="login-btn login-btn--wechat"
      bindtap="onWxLogin"
      hover-class="is-clicked"
      hover-stay-time="100"
    >
      <icon type="wechat" size="20" color="#07c160" />
      <text>微信登录</text>
    </button>
  </view>

  <text class="login-tip">首次使用将自动创建账号</text>
</view>
