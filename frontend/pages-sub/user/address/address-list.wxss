/*
 * 路线图 3.15 — mp-07 「地址管理」OD v2 视觉。
 * tokens 单一源 docs/redesign/tokens.json。
 */

.address-list-container {
  min-height: 100vh;
  background: var(--bg, #fffbf8);
  padding: 24rpx 24rpx 200rpx;
}

/* ===== 顶部选择模式标题 ===== */

.select-title {
  margin: 0 0 24rpx;
  padding: 0 8rpx;
}

.select-title__text {
  font-family: var(--font-display, serif);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg, #231814);
  line-height: 1.3;
}

/* ===== 地址卡 ===== */

.address-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.address-card {
  position: relative;
  display: flex;
  align-items: stretch;
  background: var(--surface, #fff);
  border-radius: var(--radius-xl, 14px);
  box-shadow: 0 2rpx 10rpx #231814;
  overflow: hidden;
  transition: box-shadow 0.18s ease, transform 0.18s ease;
}

.address-card.is-selected {
  box-shadow: 0 0 0 3rpx var(--accent, #db633c), 0 2rpx 10rpx #231814;
}

.address-card__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx 32rpx;
  min-width: 0;
}

.address-card__head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  flex-wrap: wrap;
}

.address-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg, #231814);
  line-height: 1.3;
}

.address-card__phone {
  font-size: 26rpx;
  color: var(--muted, #5a5451);
}

.address-card__default {
  display: inline-block;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--surface, #fff);
  background: var(--accent, #db633c);
  border-radius: var(--radius-pill, 9999px);
  line-height: 1.4;
}

.address-card__detail {
  font-size: 26rpx;
  color: var(--muted, #5a5451);
  line-height: 1.4;
}

/* ===== 操作行 ===== */

.address-card__actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx 20rpx;
  border-left: 1rpx solid var(--border, #eae3e1);
  background: var(--bg, #fffbf8);
}

.address-card__action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 12rpx;
  font-size: 22rpx;
  color: var(--fg, #231814);
  line-height: 1.2;
  border-radius: var(--radius-md, 6px);
  min-width: 80rpx;
}

.address-card__action-icon {
  font-size: 28rpx;
  line-height: 1;
}

.address-card__action--danger {
  color: var(--error, #df202e);
}

/* ===== 选择模式 radio ===== */

.address-card__radio {
  position: absolute;
  top: 28rpx;
  right: 200rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--surface, #fff);
  box-shadow: inset 0 0 0 2rpx var(--border-strong, #d5cbc8);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s ease;
}

.address-card__radio.is-checked {
  background: var(--accent, #db633c);
  box-shadow: 0 2rpx 6rpx #231814;
}

.address-card__radio-check {
  color: var(--surface, #fff);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

/* ===== 空状态 ===== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 32rpx;
  text-align: center;
}

.empty-state__icon {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-state__title {
  font-family: var(--font-display, serif);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--fg, #231814);
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.empty-state__sub {
  font-size: 26rpx;
  color: var(--muted, #5a5451);
  line-height: 1.4;
}

/* ===== 底部添加按钮 sticky ===== */

.add-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: var(--surface, #fff);
  padding: 24rpx 32rpx;
  box-shadow: 0 -2rpx 12rpx #231814;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  padding: 24rpx 32rpx;
  background: var(--accent, #db633c);
  color: var(--surface, #fff);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-pill, 9999px);
  box-shadow: 0 4rpx 12rpx #231814;
}

.add-btn__icon {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}
